{
  "name": "@qgynisc/dsh-alert-sounds",
  "version": "1.0.0",
  "description": "DeepSeek Harness Web GUI 提醒音：审批 / 提问 / 完成 / 出错 / 卡住各有音色或语音，完成提示条可常驻到鼠标移动（fork 自 @machine-126/dsh-alert-sound）",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "sound",
    "chime",
    "voice",
    "web-ui"
  ],
  "author": "qgynisc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgynisc/dsh-alert-sounds.git"
  },
  "homepage": "https://github.com/qgynisc/dsh-alert-sounds#readme",
  "bugs": {
    "url": "https://github.com/qgynisc/dsh-alert-sounds/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "rename": "node scripts/rename.mjs",
    "test": "node tests/run-all.mjs",
    "test:unit": "node tests/run-all.mjs --unit",
    "test:ci": "node scripts/build.mjs && node tests/run-all.mjs --unit && node scripts/verify-install.mjs --simulate",
    "check:upstream": "node scripts/sync-upstream.mjs --check",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "install:desktop": "node scripts/install.mjs --profile desktop",
    "uninstall:desktop": "node scripts/install.mjs --profile desktop --uninstall",
    "prepublishOnly": "node scripts/build.mjs && node tests/run-all.mjs --unit && node scripts/verify-install.mjs --simulate"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "tag-version-prefix": "v"
}
